{
  "name": "twentythree-cli",
  "version": "0.1.0",
  "description": "Terminal access to every TwentyThree API endpoint",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "twentythree": "./bin/run.js"
  },
  "main": "./dist/index.js",
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "audit-endpoints": "node scripts/audit-endpoints.mjs",
    "build": "tsdown --config-loader unrun",
    "postbuild": "oclif manifest",
    "dev": "node ./bin/dev.js",
    "test": "vitest run"
  },
  "oclif": {
    "bin": "twentythree",
    "dirname": "twentythree",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@napi-rs/keyring": "^1.2.0",
    "@oclif/core": "^4.10.5",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "conf": "^15.1.0",
    "openapi-fetch": "^0.17.0",
    "ora": "^5.4.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@oclif/test": "^4.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/proper-lockfile": "^4.1.4",
    "oclif": "^4.23.0",
    "openapi-typescript": "^7.13.0",
    "tsdown": "^0.21.8",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  }
}
