{
  "private": true,
  "name": "twentythree-cli-monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "generate-types": "pnpm --filter twentythree-cli exec openapi-typescript specs/twentythree-api-swagger.json -o src/api/types.ts",
    "update-api-spec": "cd packages/twentythree-cli && ./update-api-spec.sh"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "@changesets/cli": "^2.30.0",
    "typescript": "^5.0.0"
  }
}
